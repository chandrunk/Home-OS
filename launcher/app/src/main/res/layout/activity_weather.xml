<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E18"
    android:clipChildren="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="26dp"
            android:paddingBottom="22dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Row: Current Weather & Air Quality Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <!-- Left Column: Current Weather -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PUTRAJAYA"
                            android:textColor="#94A3B8"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.12"
                            android:textAllCaps="true"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/btnChangeLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_location_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:text="📍 Tukar Stesen / Change"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/weatherMainIcon"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="16dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_weather_partly_cloudy" />

                        <TextView
                            android:id="@+id/weatherMainTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="29°"
                            android:textColor="#FFFFFFFF"
                            android:textSize="56sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/weatherMainCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Partly cloudy"
                                android:textColor="#FFFFFFFF"
                                android:textSize="20sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:includeFontPadding="false"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/weatherMainSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Feels like 35°  •  H 34° L 26°"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherDetail1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Humidity 79%  •  Wind 8 km/h  •  UV 0"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/weatherDetail2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Rain chance today 84%  •  Sunrise 6:53 AM  •  Sunset 6:56 PM"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Right Column: Air Quality Card -->
                <LinearLayout
                    android:id="@+id/aqiCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:background="@drawable/weather_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIR QUALITY"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/aqiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="98"
                            android:textColor="#4ADE80"
                            android:textSize="40sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/aqiStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Moderate"
                                android:textColor="#4ADE80"
                                android:textSize="17sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 600"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/aqiStation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="API  •  BANDARAYA MELAKA  •  PM2.5"
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Gauge Bar -->
                    <RelativeLayout
                        android:id="@+id/aqiBarContainer"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp">

                        <View
                            android:id="@+id/aqiBar"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_centerVertical="true"
                            android:background="@drawable/aqi_gauge_gradient" />

                        <View
                            android:id="@+id/aqiIndicator"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_centerVertical="true"
                            android:background="@drawable/aqi_indicator" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/aqiStationsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Alor Gajah 97  •  Bukit Rambai 110"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/aqiModelSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Model US AQI 210  •  PM2.5 57  •  PM10 58 µg/m³"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/aqiAdvisory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Normal activities. People with heart or lung conditions should limit long outdoor exertion."
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Middle Row: Next 12 Hours -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="NEXT 12 HOURS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fillViewport="true"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/hourlyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>

            <!-- Bottom Row: 7 Days -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="7 DAYS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/dailyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <!-- Footer: Source and Timestamp -->
            <TextView
                android:id="@+id/weatherFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Updated 7:40 PM  •  API: Jabatan Alam Sekitar (APIMS), reading at 7:00 PM  •  Weather and US AQI: Open-Meteo model"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:singleLine="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
